# =====================================================================
# Biến môi trường cho backend TourDuLich.
# Sao chép file này thành ".env" (file .env đã nằm trong .gitignore, KHÔNG commit) rồi điền giá trị.
# Backend tự đọc backend/.env (hoặc .env ở thư mục chạy) khi khởi động, không cần plugin IDE.
# Định dạng: KEY=giá trị (không có dấu nháy, không có khoảng trắng quanh dấu =).
# Mọi biến đều có giá trị mặc định cho môi trường dev, chỉ cần đặt những gì muốn đổi.
# =====================================================================

# ---------- Cơ sở dữ liệu (MariaDB) ----------
DB_USERNAME=root
DB_PASSWORD=sapassword

# ---------- Bảo mật ----------
# JWT: tối thiểu 32 ký tự. PHẢI đổi khi triển khai thật.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Tài khoản Admin tạo ở lần chạy đầu
ADMIN_EMAIL=admin@tourdulich.local
ADMIN_PASSWORD=Admin@123

# ---------- Email (để MAIL_ENABLED=false thì chỉ ghi log, không gửi thật) ----------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@tourdulich.local
MAIL_ADMIN=admin@tourdulich.local

# ---------- Thanh toán chuyển khoản QR (VietQR) ----------
PAYMENT_BANK_NAME=Vietcombank
PAYMENT_BANK_CODE=VCB
PAYMENT_ACCOUNT_NUMBER=0123456789
PAYMENT_ACCOUNT_NAME=CONG TY DU LICH NHOM 22
PAYMENT_WEBHOOK_KEY=dev-webhook-key-change-me
# true: hiện nút "thanh toán giả lập" để demo. PHẢI để false khi triển khai thật.
PAYMENT_SIMULATE_ENABLED=true

# ---------- Dữ liệu mẫu ----------
SEED_DEMO_DATA=true
# Đặt true MỘT LẦN để xóa dữ liệu mẫu rồi nạp lại từ database/seed.sql (cẩn thận: xóa đơn đặt tour)
# SEED_RESET=true

# ---------- Trợ lý AI (Gemini) ----------
# Lấy key tại https://aistudio.google.com/apikey  (KHÔNG commit key lên git)
# Có ít nhất một key thì trợ lý AI tự bật. Điền thêm key dự phòng để tự chuyển khi key đang dùng hết hạn mức hoặc lỗi.
# (Mỗi key nên thuộc một project Google khác nhau thì hạn mức mới tách biệt.)
GEMINI_API_KEY=
#GEMINI_API_KEY_2=
#GEMINI_API_KEY_3=
# Hoặc đặt tất cả trong một dòng, cách nhau bằng dấu phẩy:
#GEMINI_API_KEYS=key1,key2,key3
# Danh sách mô hình chat theo thứ tự ưu tiên (cách nhau bằng dấu phẩy); mô hình nào không dùng được thì tự chuyển cái kế tiếp.
# Lưu ý: key của project Google mới có thể không còn gemini-2.5-flash (lỗi 404 "no longer available"), nên luôn có bản dự phòng.
GEMINI_CHAT_MODEL=gemini-2.5-flash,gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Thư mục tài liệu bổ sung cho AI (mỗi file .md/.txt là một tài liệu) và nơi lưu vector
#AI_KNOWLEDGE_DIR=./ai-knowledge
#AI_STORE_PATH=./data/ai/vector-store.json

# Che email/SĐT trong lịch sử chat (true = che, false = lưu nguyên để admin xem)
AI_CHAT_REDACT=true
